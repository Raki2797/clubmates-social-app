NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# Supabase Postgres connection string.
# Use the server-side database URL from Supabase Project Settings > Database.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
DATABASE_SSL=true

# Keep secrets server-side. Do not put service-role keys in the iOS app.
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_DAYS=30
OFFLINE_CHECKOUT_GRACE_MINUTES=20
OTP_EXPIRY_MINUTES=5

# Local-only OTP bypass. Used only when MSG91_* is not configured and NODE_ENV is not production.
DEV_OTP_CODE=123456

# MSG91 OTP delivery. Required in production.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=
MSG91_TIMEOUT_MS=10000
# MSG91_API_BASE_URL=https://control.msg91.com

# Comma-separated origins, or * while developing.
CORS_ORIGIN=*

# Optional Supabase service config for storage/realtime integrations.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROFILE_PHOTOS_BUCKET=profile-photos
SUPABASE_SIGNED_URL_TTL_SECONDS=3600

# Optional local face verification runtime. The backend uses this when running photo comparisons.
FACE_VERIFICATION_PYTHON_BIN=/absolute/path/to/python
FACE_EMBEDDING_SCRIPT_PATH=/absolute/path/to/ClubMates/Backend/scripts/extract_embedding.py
FACE_VERIFICATION_DEEPFACE_HOME=/absolute/path/to/ClubMates/Backend/.deepface-home
FACE_VERIFICATION_MODEL=ArcFace
FACE_VERIFICATION_DETECTOR=scrfd
FACE_VERIFICATION_DISTANCE_METRIC=cosine
FACE_VERIFICATION_THRESHOLD=0.70
FACE_ANTI_SPOOF_MODEL_PATH=/absolute/path/to/ClubMates/Backend/models/minifasnet_v2.onnx
FACE_ANTI_SPOOF_THRESHOLD=0.50
FACE_VERIFICATION_TIMEOUT_MS=120000
